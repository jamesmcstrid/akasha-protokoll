<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mall: mac/installera.sh byter __REPO__ och __LOGG__ och lagger filen i ~/Library/LaunchAgents/ -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.akasha-meet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/mac/kor.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Startas om om den kraschar, men inte om den stoppas med flit. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__LOGG__</string>
  <key>StandardErrorPath</key>
  <string>__LOGG__</string>
</dict>
</plist>
