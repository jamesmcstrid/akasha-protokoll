# Akasha Meet. Alla rader ar valfria: ta bort # framfor en rad for att andra standardvardet.
# Starta sedan om tjansten:  launchctl kickstart -k gui/$(id -u)/local.akasha-meet
# Inga hemligheter behovs.

# faster     = faster-whisper pa CPU. Fungerar overallt (standard).
# whispercpp = whisper.cpp med Metal (GPU) pa Apple Silicon. Kraver: brew install whisper-cpp
#              och  bash mac/hamta-modeller.sh ggml
#MOTOR=faster

# Ord som alltid hjalper whisper att stava ratt, t.ex. foretagets namn och facktermer.
#ORDLISTA=Exempelbolaget, ISO 9001, ledningens genomgang

# Var inspelningar och texter sparas. Valj inte Dokument eller Skrivbord om de synkas till iCloud.
#DATAKATALOG=~/AkashaMeet

#PORT=8611
#MODELLKATALOG=
#TALARE_TROSKEL=0.8
#CPU_TRADAR=0
#MAX_MB=1024
