# Akasha Protokoll. Alla rader ar valfria: ta bort # framfor en rad for att andra standardvardet.
# Starta sedan om tjansten:  launchctl kickstart -k gui/$(id -u)/local.akasha-meet
# Inga hemligheter behovs.

# auto       = whisper.cpp med Metal (GPU) pa Mac med Apple Silicon, annars faster-whisper (standard)
# whispercpp = alltid whisper.cpp. Kraver: brew install whisper-cpp (programmet har det inbyggt)
# faster     = alltid faster-whisper pa CPU
#MOTOR=auto

# KB-Whisper medium (standard) eller large. Large gor farre fel men tar langre tid och behover
# mer minne. Starta om tjansten efter att du andrat. Sidan erbjuder da att hamta modellen.
#MODELL=medium

# Ord som alltid hjalper whisper att stava ratt, t.ex. foretagets namn och facktermer.
#ORDLISTA=Foretagets namn, produktnamn

# Var inspelningar och texter sparas. Valj inte Dokument eller Skrivbord om de synkas till iCloud.
#DATAKATALOG=~/AkashaMeet

#PORT=8611
#MODELLKATALOG=
# Bara pa nat som kraver proxy: anvands nar modellerna hamtas.
#HTTPS_PROXY=
#REQUESTS_CA_BUNDLE=
# Tva roster som liknar varandra mer an sa har raknas som samma person (0-1).
#TALARE_TROSKEL=0.6
#CPU_TRADAR=0
#MAX_MB=1024
